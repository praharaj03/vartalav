# Clerk authentication (use production keys for Vercel Production)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stream Video (same Stream app for the client API key and server secret)
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_SECRET_KEY=

# Public production URL, with no trailing slash (for example https://your-domain.com)
NEXT_PUBLIC_BASE_URL=https://your-domain.com
